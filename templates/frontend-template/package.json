{
  "name": "@repo/frontend-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --mode development",
    "deploy": "wrangler deploy --config wrangler.deploy.jsonc --minify",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview --mode development",
    "test": "vitest",
    "ui_test": "playwright test",
    "ui_test:prepare": "playwright install --with-deps",
    "ui_test:report": "playwright show-report --host 0.0.0.0",
    "build": "app-build",
    "sync:local": "sync-local",
    "undeploy:preview": "delete-preview-worker"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@repo/app-config": "workspace:*",
    "@repo/deployment-scripts": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-dom": "^5.18.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-react-x": "^5.18.6",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
