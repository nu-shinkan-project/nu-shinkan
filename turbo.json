{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [
    "apps/**/src/**",
    "packages/**/src/**",
    "packages/**/package.json",
    "packages/typescript-config/*.json",
    "packages/eslint-config/*.js",
    "apps/**/wrangler.jsonc",
    "apps/**/.env.development",
    "packages/app-config/globalRuntimeEnvs.yaml"
  ],
  "globalEnv": ["CI", "TEST", "NODE_ENV", "VITE_*"],
  "tasks": {
    "bootstrap": {
      "dependsOn": ["^bootstrap"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "sync:local": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "ui_test": {
      "outputs": ["playwright-report/**", "test-results/**"],
      "dependsOn": ["^ui_test"]
    },
    "ui_test:prepare": {
      "cache": false,
      "dependsOn": ["^ui_test:prepare"]
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/app-config/globalRuntimeEnvs.yaml"
      ],
      "outputs": ["dist/**", "bin/**"],
      "env": ["NODE_ENV", "VITE_*"]
    },
    "deploy": {
      "cache": false,
      "env": [
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "DEPLOY_CHANNEL",
        "PR_NUMBER",
        "TARGETS"
      ]
    },
    "undeploy:preview": {
      "cache": false,
      "env": ["PR_NUMBER", "CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    }
  }
}
