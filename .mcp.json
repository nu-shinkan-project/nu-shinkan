{
	"mcpServers": {
		"github-mcp-server": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"tools": [
				"*"
			],
			"headers": {
				"Authorization": "Bearer ${GITHUB_MCP_BEARER_TOKEN}"
			}
		},
		"notion-mcp-server": {
			"type": "http",
			"url": "https://mcp.notion.com/mcp",
			"tools": [
				"*"
			]
		}
	}
}
