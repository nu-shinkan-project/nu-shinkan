  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./interface": "./src/interface.ts"
  },
  "scripts": {
    "dev": "wrangler dev --host 0.0.0.0 --port 6174 --inspector-port 9230",
    "deploy": "wrangler deploy --config wrangler.deploy.jsonc --minify",
