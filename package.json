{
  "name": "nu-shinkan",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=\"./apps/*\"",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "ui_test": "turbo run ui_test",
    "ui_test:prepare": "turbo run ui_test:prepare",
    "sync": "tsx scripts/sync-env/sync.ts",
    "make:backend": "tsx scripts/make-app/make-backend-app.ts",
    "make:frontend": "tsx scripts/make-app/make-frontend-app.ts",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "husky": "^8.0.0",
    "lint-staged": "^17.4.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  }
}
